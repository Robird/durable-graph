  <PropertyGroup>
    <DurableGraphSnapshotHistoryDirectory Condition="'$(DurableGraphSnapshotHistoryDirectory)' == ''">$(MSBuildProjectDirectory)/DurableGraphSnapshots</DurableGraphSnapshotHistoryDirectory>
