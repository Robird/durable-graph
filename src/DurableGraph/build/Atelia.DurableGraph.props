<Project>
  <PropertyGroup>
    <DurableGraphSchemaHistoryDirectory Condition="'$(DurableGraphSchemaHistoryDirectory)' == ''">$(MSBuildProjectDirectory)/DurableGraphSchemaHistory</DurableGraphSchemaHistoryDirectory>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="DurableGraphGenerateDefinitions" />
  </ItemGroup>
</Project>
