<Project>
  <PropertyGroup>
    <DurableGraphSchemaHistoryMode Condition="'$(DurableGraphSchemaHistoryMode)' == '' and '$(ContinuousIntegrationBuild)' == 'true'">Verify</DurableGraphSchemaHistoryMode>
    <DurableGraphSchemaHistoryMode Condition="'$(DurableGraphSchemaHistoryMode)' == ''">Publish</DurableGraphSchemaHistoryMode>
    <_DurableGraphBuildTool>$(MSBuildThisFileDirectory)../tools/net10.0/Atelia.DurableGraph.Build.dll</_DurableGraphBuildTool>
    <_DurableGraphDotNetHost Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</_DurableGraphDotNetHost>
    <_DurableGraphDotNetHost Condition="'$(_DurableGraphDotNetHost)' == ''">dotnet</_DurableGraphDotNetHost>
    <_DurableGraphLegacyDefaultSchemaHistoryDirectory>$(MSBuildProjectDirectory)/DurableGraphSnapshots</_DurableGraphLegacyDefaultSchemaHistoryDirectory>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(DurableGraphSchemaHistoryDirectory)')">
    <AdditionalFiles Include="$(DurableGraphSchemaHistoryDirectory)/*.dgschema"
                     Visible="false" />
  </ItemGroup>

  <Target Name="DurableGraphRejectLegacySchemaHistory"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true'
                     and '$(BuildingProject)' == 'true'
                     and '$(Language)' == 'C#'">
    <ItemGroup>
      <_DurableGraphLegacySchemaHistory Include="$(DurableGraphSchemaHistoryDirectory)/*.dgsnapshot" />
      <_DurableGraphLegacyDefaultSchemaHistory Include="$(_DurableGraphLegacyDefaultSchemaHistoryDirectory)/*.dgsnapshot" />
    </ItemGroup>
    <Error Condition="'$(DurableGraphSnapshotHistoryDirectory)' != ''"
           Text="DurableGraphSnapshotHistoryDirectory has been removed; use DurableGraphSchemaHistoryDirectory and .dgschema files." />
    <Error Condition="'@(_DurableGraphLegacySchemaHistory->Count())' != '0'"
           Text="DurableGraph Schema-history directory contains legacy .dgsnapshot files; regenerate them as .dgschema because legacy history is not accepted." />
    <Error Condition="'@(_DurableGraphLegacyDefaultSchemaHistory->Count())' != '0'"
           Text="The legacy default DurableGraphSnapshots directory contains .dgsnapshot files; move regenerated .dgschema history to DurableGraphSchemaHistory." />
  </Target>

  <Target Name="DurableGraphProcessSchemaHistory"
          AfterTargets="CoreCompile"
          Condition="'$(DurableGraphSchemaHistoryMode)' != 'Off'
                     and '$(DesignTimeBuild)' != 'true'
                     and '$(BuildingProject)' == 'true'
                     and '$(Language)' == 'C#'">
    <ItemGroup>
      <_DurableGraphSchemaHistoryManifest Include="$(CompilerGeneratedFilesOutputPath)/**/DurableGraphSchemaHistoryCandidates.g.cs" />
    </ItemGroup>

    <Error Condition="'$(DurableGraphSchemaHistoryMode)' != 'Publish' and '$(DurableGraphSchemaHistoryMode)' != 'Verify'"
           Text="DurableGraphSchemaHistoryMode must be Publish, Verify, or Off; found '$(DurableGraphSchemaHistoryMode)'." />
    <Error Condition="'@(_DurableGraphSchemaHistoryManifest->Count())' != '1'"
           Text="DurableGraph expected exactly one Schema-history candidate manifest under '$(CompilerGeneratedFilesOutputPath)' but found @(_DurableGraphSchemaHistoryManifest->Count()). Clean the project and rebuild, and do not disable EmitCompilerGeneratedFiles." />
    <Error Condition="!Exists('$(_DurableGraphBuildTool)')"
           Text="DurableGraph Schema-history tool was not found at '$(_DurableGraphBuildTool)'." />

    <Exec Condition="'@(_DurableGraphSchemaHistoryManifest->Count())' == '1' and '$(DurableGraphSchemaHistoryMode)' == 'Publish'"
          Command="&quot;$(_DurableGraphDotNetHost)&quot; &quot;$(_DurableGraphBuildTool)&quot; publish --manifest &quot;@(_DurableGraphSchemaHistoryManifest)&quot; --schema-history &quot;$(DurableGraphSchemaHistoryDirectory)&quot;" />
    <Exec Condition="'@(_DurableGraphSchemaHistoryManifest->Count())' == '1' and '$(DurableGraphSchemaHistoryMode)' == 'Verify'"
          Command="&quot;$(_DurableGraphDotNetHost)&quot; &quot;$(_DurableGraphBuildTool)&quot; verify --manifest &quot;@(_DurableGraphSchemaHistoryManifest)&quot; --schema-history &quot;$(DurableGraphSchemaHistoryDirectory)&quot;" />
  </Target>
</Project>
