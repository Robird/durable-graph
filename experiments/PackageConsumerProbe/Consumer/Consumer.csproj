<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Domain.None.cs" Condition="'$(ProbeVersion)' == '0'" />
    <Compile Include="Domain.V1.cs" Condition="'$(ProbeVersion)' == '1'" />
    <Compile Include="Domain.V2.cs" Condition="'$(ProbeVersion)' == '2'" />
    <Compile Include="Domain.Binary.cs" Condition="'$(ProbeVersion)' == '3'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Atelia.DurableGraph"
                      Version="$(DurableGraphPackageVersion)" />
  </ItemGroup>

</Project>
