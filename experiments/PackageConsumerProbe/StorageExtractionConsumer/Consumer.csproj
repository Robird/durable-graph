<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Atelia.StorageExtractionConsumer</AssemblyName>
    <DurableGraphGenerateDefinitions>true</DurableGraphGenerateDefinitions>
    <WarningsAsErrors>$(WarningsAsErrors);CS0433;CS0436;NU1605</WarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Atelia.DurableGraph" Version="[$(DurableGraphPackageVersion)]" />
    <PackageReference Include="Atelia.DurableGraph.Persistence" Version="[$(DurableGraphPackageVersion)]" />
    <!-- This migration witness intentionally selects all five substrate packages. -->
    <PackageReference Include="Atelia.Primitives" Version="[$(StoragePackageVersion)]" />
    <PackageReference Include="Atelia.Data" Version="[$(StoragePackageVersion)]" />
    <PackageReference Include="Atelia.Rbf" Version="[$(StoragePackageVersion)]" />
    <PackageReference Include="Atelia.RbfSegmentStore" Version="[$(StoragePackageVersion)]" />
    <PackageReference Include="Atelia.EventJournal" Version="[$(StoragePackageVersion)]" />
  </ItemGroup>
</Project>
